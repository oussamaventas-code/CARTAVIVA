# Copia este archivo como .env.local dentro de apps/admin y apps/restaurant,
# y rellena los valores con los de tu proyecto de Supabase
# (Project Settings -> API).
#
# NUNCA subas el .env.local real al repositorio: contiene tus claves.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_public_key

# Solo para apps/admin: URL pública donde está desplegada la carta del cliente
# (apps/restaurant). Es la que se codifica dentro de los códigos QR.
# En local no hace falta: por defecto usa http://localhost:3001
VITE_PUBLIC_MENU_URL=https://tu-carta.vercel.app
